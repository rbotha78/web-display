[Unit]
Description=Web Display Bluetooth speaker supervisor
After=bluetooth.service bluealsa.service web-display.service
Wants=bluetooth.service bluealsa.service
Requires=web-display.service

[Service]
Type=simple
Environment=PYTHONPATH=/var/lib/web-display-app/current
ExecStart=/usr/bin/python3 -m webdisplay.bluetooth supervise
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/web-display
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
