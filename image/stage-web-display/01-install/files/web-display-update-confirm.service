[Unit]
Description=Web Display update health confirmation
After=web-display.service web-display-kiosk.service web-display-network.service
Wants=web-display.service web-display-kiosk.service web-display-network.service

[Service]
Type=simple
ExecStart=/usr/lib/web-display/update-action confirm
StateDirectory=web-display-app
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/web-display-app
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
